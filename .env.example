# Backend runtime configuration
DB_URL=jdbc:mysql://127.0.0.1:3306/eventease_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_NAME=eventease_db
DB_USERNAME=eventease_user
DB_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8082
EVENT_SERVICE_URL=http://localhost:8082
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OPENAI_API_KEY=
AI_ENABLED=false
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_ANON_RPM=10

# Frontend build-time configuration
VITE_API_BASE_URL=http://localhost:8081
VITE_EVENT_API_BASE_URL=http://localhost:8082
